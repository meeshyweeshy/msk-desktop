{
  "name": "msk",
  "productName": "MSK",
  "version": "1.4.0",
  "description": "MSK - custom backgrounds and chart colors for TradingView Desktop (Windows & macOS)",
  "author": "meeshy",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icons.mjs",
    "dist": "electron-builder --win nsis zip --x64",
    "ext": "node scripts/build-extension.mjs",
    "banner": "node scripts/make-banner.mjs",
    "dist-mac": "electron-builder --mac dmg zip --arm64 --x64"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "png-to-ico": "^3.0.2",
    "resedit": "^3.1.0"
  },
  "build": {
    "appId": "com.meeshy.msk",
    "productName": "MSK",
    "copyright": "meeshy",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/tray.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "extraFiles": [
        {
          "from": "build/MSK Debug.cmd",
          "to": "MSK Debug.cmd"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MSK",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "MSK-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.finance",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "extendInfo": {
        "LSUIElement": false,
        "NSHighResolutionCapable": true
      }
    },
    "dmg": {
      "artifactName": "MSK-${version}-mac-${arch}.${ext}",
      "title": "MSK ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "afterPack": "scripts/after-pack.js",
    "artifactName": "MSK-${version}-${os}-${arch}.${ext}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/meeshyweeshy/msk-desktop.git"
  },
  "homepage": "https://github.com/meeshyweeshy/msk-desktop"
}
